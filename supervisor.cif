alg int[0..24] total_opening = if Gate1.Open: 6 elif Gate1.Halfway: 3 else 0 end + if Gate2.Open: 6 elif Gate2.Halfway: 3 else 0 end + if Gate3.Open: 6 elif Gate3.Halfway: 3 else 0 end + if Gate4.Open: 6 elif Gate4.Halfway: 3 else 0 end;
alg bool flow_safe = sea_level.ls = fjord_level.lf or total_opening * 5 < 100;
plant automaton sea_level:
  uncontrollable u_sea_tick;
  disc int[0..5] ls = 0;
  location Rising0:
    initial;
    marked;
    edge u_sea_tick do ls := 1 goto Rising1;
  location Rising1:
    marked;
    edge u_sea_tick do ls := 2 goto Rising2;
  location Rising2:
    marked;
    edge u_sea_tick do ls := 3 goto Rising3;
  location Rising3:
    marked;
    edge u_sea_tick do ls := 4 goto Rising4;
  location Rising4:
    marked;
    edge u_sea_tick do ls := 5 goto Falling5;
  location Falling5:
    marked;
    edge u_sea_tick do ls := 4 goto Falling4;
  location Falling4:
    marked;
    edge u_sea_tick do ls := 3 goto Falling3;
  location Falling3:
    marked;
    edge u_sea_tick do ls := 2 goto Falling2;
  location Falling2:
    marked;
    edge u_sea_tick do ls := 1 goto Falling1;
  location Falling1:
    marked;
    edge u_sea_tick do ls := 0 goto Rising0;
end
plant automaton Gate1:
  controllable c_raise;
  controllable c_lower;
  location Closed:
    marked;
    edge c_raise goto Halfway;
  location Halfway:
    initial;
    marked;
    edge c_raise goto Open;
    edge c_lower goto Closed;
  location Open:
    marked;
    edge c_lower goto Halfway;
end
plant automaton Gate2:
  controllable c_raise;
  controllable c_lower;
  location Closed:
    marked;
    edge c_raise goto Halfway;
  location Halfway:
    initial;
    marked;
    edge c_raise goto Open;
    edge c_lower goto Closed;
  location Open:
    marked;
    edge c_lower goto Halfway;
end
plant automaton Gate3:
  controllable c_raise;
  controllable c_lower;
  location Closed:
    marked;
    edge c_raise goto Halfway;
  location Halfway:
    initial;
    marked;
    edge c_raise goto Open;
    edge c_lower goto Closed;
  location Open:
    marked;
    edge c_lower goto Halfway;
end
plant automaton Gate4:
  controllable c_raise;
  controllable c_lower;
  location Closed:
    marked;
    edge c_raise goto Halfway;
  location Halfway:
    initial;
    marked;
    edge c_raise goto Open;
    edge c_lower goto Closed;
  location Open:
    marked;
    edge c_lower goto Halfway;
end
plant automaton fjord_level:
  uncontrollable u_fjord_rise;
  uncontrollable u_fjord_lower;
  disc int[0..5] lf = 2;
  alg bool any_gate_open = Gate1.Halfway or Gate1.Open or Gate2.Halfway or Gate2.Open or Gate3.Halfway or Gate3.Open or Gate4.Halfway or Gate4.Open;
  alg bool draining = any_gate_open and lf > sea_level.ls;
  location Normal:
    initial;
    marked;
    edge u_fjord_rise when lf < 5 and rain.Raining and not any_gate_open do lf := lf + 1;
    edge u_fjord_lower when lf > 0 and draining do lf := lf - 1;
end
plant automaton fjord_tick:
  location Idle:
    initial;
    marked;
    edge fjord_level.u_fjord_rise goto WaitTick1;
    edge fjord_level.u_fjord_lower goto WaitTick1;
  location WaitTick1:
    marked;
    edge sea_level.u_sea_tick goto WaitTick2;
  location WaitTick2:
    marked;
    edge sea_level.u_sea_tick goto Idle;
end
plant automaton rain:
  uncontrollable u_rain_start;
  uncontrollable u_rain_stop;
  location Dry:
    initial;
    marked;
    edge u_rain_start goto Raining;
  location Raining:
    marked;
    edge u_rain_stop goto Dry;
end
plant automaton gate_timer:
  uncontrollable u_timer_done;
  location Ready:
    initial;
    marked;
    edge Gate1.c_raise, Gate1.c_lower, Gate2.c_raise, Gate2.c_lower, Gate3.c_raise, Gate3.c_lower, Gate4.c_raise, Gate4.c_lower goto Cooldown;
  location Cooldown:
    edge u_timer_done goto Ready;
end
plant automaton SignNorth:
  controllable c_sign_stop;
  controllable c_sign_go;
  location Stop:
    initial;
    marked;
    edge c_sign_go goto Go;
  location Go:
    edge c_sign_stop goto Stop;
end
plant automaton SignSouth:
  controllable c_sign_stop;
  controllable c_sign_go;
  location Stop:
    initial;
    marked;
    edge c_sign_go goto Go;
  location Go:
    edge c_sign_stop goto Stop;
end
plant automaton ShipNorth:
  uncontrollable u_ship_arrive;
  uncontrollable u_ship_pass;
  uncontrollable u_ship_leave;
  alg bool sign_is_go = SignNorth.Go;
  location NoShip:
    initial;
    marked;
    edge u_ship_arrive goto Waiting;
  location Waiting:
    edge u_ship_pass when sign_is_go goto Passing;
  location Passing:
    edge u_ship_leave goto NoShip;
end
plant automaton ShipSouth:
  uncontrollable u_ship_arrive;
  uncontrollable u_ship_pass;
  uncontrollable u_ship_leave;
  alg bool sign_is_go = SignSouth.Go;
  location NoShip:
    initial;
    marked;
    edge u_ship_arrive goto Waiting;
  location Waiting:
    edge u_ship_pass when sign_is_go goto Passing;
  location Passing:
    edge u_ship_leave goto NoShip;
end
supervisor automaton gate_interval:
  location Ready:
    initial;
    marked;
    edge Gate1.c_raise, Gate1.c_lower, Gate2.c_raise, Gate2.c_lower, Gate3.c_raise, Gate3.c_lower, Gate4.c_raise, Gate4.c_lower goto Cooldown;
  location Cooldown:
    edge gate_timer.u_timer_done goto Ready;
end
supervisor automaton sup:
