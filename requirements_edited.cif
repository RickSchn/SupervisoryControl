import "plant.cif";


// -----------------------------------------------------------------------------
// Assumptions for the current plant interface
// - Gate height abstraction: h = 0,1,2 corresponds to 0 m, 3 m, 6 m opening.
// - Ship sign abstraction: ships.red = ships must wait, ships.green = ships may enter.
// - G3 interpretation for this abstraction: one uncontrollable u_gate_step models
//   the required 5 s separation between two gate-actuation starts.
// -----------------------------------------------------------------------------

// Fjord level zones in mm.
alg bool fjord_near_low  = fjord_water_level.lvl <= 1500;
alg bool fjord_near_high = fjord_water_level.lvl >= 3500;
alg bool fjord_noncritical = not (fjord_near_low or fjord_near_high);
alg bool fjord_force_high_close = fjord_water_level.lvl >= 3730;

// -----------------------------------------------------------------------------
// Hydraulic policy helpers.
// -----------------------------------------------------------------------------
alg bool sea_rising  = sea_level.k >= 60 and sea_level.k < 180;
alg bool sea_falling = not sea_rising;

alg int policy_margin = 50;

// Hysteresis around the sea=fjord crossover.
alg bool sea_well_above_fjord =
    sea_level.current_water_level >= fjord_water_level.lvl + policy_margin;
alg bool sea_well_below_fjord =
    sea_level.current_water_level <= fjord_water_level.lvl - policy_margin;


// Sea thresholds in mm for the current 240-step abstraction.
// G1 itself is "above 4.5 m" -> strictly greater than 4500 mm.
alg bool sea_close_zone = sea_level.current_water_level > 4500;

// Conservative pre-close zone: two sea samples before the first value > 4500.
alg bool sea_preclose_zone = sea_level.current_water_level >= 4443;

// Ship-safety condition from S1.
alg bool ship_flow_safe = abs(fjord_water_level.gate_flow) <= 100;

// -----------------------------------------------------------------------------
// G1: Gates must close when sea water level is above 4.5 m.
// Conservative pre-close restriction added for the coarse abstraction.
// -----------------------------------------------------------------------------
requirement invariant not (sea_close_zone and Gate1.h > 0);
requirement invariant not (sea_close_zone and Gate2.h > 0);
requirement invariant not (sea_close_zone and Gate3.h > 0);
requirement invariant not (sea_close_zone and Gate4.h > 0);

requirement req_no_rise_in_preclose:
    location Ok:
        initial;
        marked;

        edge Gate1.c_gate_rise when not sea_preclose_zone;
        edge Gate2.c_gate_rise when not sea_preclose_zone;
        edge Gate3.c_gate_rise when not sea_preclose_zone;
        edge Gate4.c_gate_rise when not sea_preclose_zone;
end

// -----------------------------------------------------------------------------
// G2: At most intermediary height when fjord level is noncritical.
// In the 0/1/2 abstraction, intermediary height is h = 1.
// -----------------------------------------------------------------------------

requirement invariant not (fjord_noncritical and Gate1.h > 1);
requirement invariant not (fjord_noncritical and Gate2.h > 1);
requirement invariant not (fjord_noncritical and Gate3.h > 1);
requirement invariant not (fjord_noncritical and Gate4.h > 1);

// -----------------------------------------------------------------------------
// G3: 5 s interval between gate-actuation starts.
// Modeled here by requiring one uncontrollable u_gate_step between any two
// controllable start events (rise/lower).
// -----------------------------------------------------------------------------

requirement gate_start_interval:
    location Ready:
        initial;
        marked;

        edge Gate1.c_gate_rise  goto Wait;
        edge Gate1.c_gate_lower goto Wait;
        edge Gate2.c_gate_rise  goto Wait;
        edge Gate2.c_gate_lower goto Wait;
        edge Gate3.c_gate_rise  goto Wait;
        edge Gate3.c_gate_lower goto Wait;
        edge Gate4.c_gate_rise  goto Wait;
        edge Gate4.c_gate_lower goto Wait;

        edge u_sea_step;
        edge u_start_rain;
        edge u_stop_rain;
        edge c_ship_green;
        edge c_ship_red;

    location Wait:
        marked;

        edge Gate1.u_gate_step goto Ready;
        edge Gate2.u_gate_step goto Ready;
        edge Gate3.u_gate_step goto Ready;
        edge Gate4.u_gate_step goto Ready;

        edge u_start_rain;
        edge u_stop_rain;
        edge c_ship_green;
        edge c_ship_red;
end

// -----------------------------------------------------------------------------
// Hydraulic policy automaton with hysteresis.
// -----------------------------------------------------------------------------

requirement hydraulic_policy:
    location Neutral:
        initial;
        marked;

        edge u_sea_step when fjord_noncritical goto Neutral;
        edge u_sea_step when fjord_near_low and sea_rising and sea_well_above_fjord goto LowRefill;
        edge u_sea_step when fjord_near_low and not (sea_rising and sea_well_above_fjord) goto LowConserve;
        edge u_sea_step when fjord_near_high and sea_falling and sea_well_below_fjord goto HighDrain;
        edge u_sea_step when fjord_near_high and not (sea_falling and sea_well_below_fjord) goto HighProtect;

    location LowConserve:
        marked;

        edge u_sea_step when fjord_noncritical goto Neutral;
        edge u_sea_step when fjord_near_low and sea_rising and sea_well_above_fjord goto LowRefill;
        edge u_sea_step when fjord_near_low and not (sea_rising and sea_well_above_fjord) goto LowConserve;
        edge u_sea_step when fjord_near_high and sea_falling and sea_well_below_fjord goto HighDrain;
        edge u_sea_step when fjord_near_high and not (sea_falling and sea_well_below_fjord) goto HighProtect;

    location LowRefill:
        marked;

        edge u_sea_step when fjord_noncritical goto Neutral;
        edge u_sea_step when fjord_near_low and (sea_falling or sea_well_below_fjord) goto LowConserve;
        edge u_sea_step when fjord_near_low and not (sea_falling or sea_well_below_fjord) goto LowRefill;
        edge u_sea_step when fjord_near_high and sea_falling and sea_well_below_fjord goto HighDrain;
        edge u_sea_step when fjord_near_high and not (sea_falling and sea_well_below_fjord) goto HighProtect;

    location HighProtect:
        marked;

        edge u_sea_step when fjord_noncritical goto Neutral;
        edge u_sea_step when fjord_near_high and sea_falling and sea_well_below_fjord goto HighDrain;
        edge u_sea_step when fjord_near_high and not (sea_falling and sea_well_below_fjord) goto HighProtect;
        edge u_sea_step when fjord_near_low and sea_rising and sea_well_above_fjord goto LowRefill;
        edge u_sea_step when fjord_near_low and not (sea_rising and sea_well_above_fjord) goto LowConserve;

    location HighDrain:
        marked;

        edge u_sea_step when fjord_noncritical goto Neutral;
        edge u_sea_step when fjord_near_high and (sea_rising or sea_well_above_fjord) goto HighProtect;
        edge u_sea_step when fjord_near_high and not (sea_rising or sea_well_above_fjord) goto HighDrain;
        edge u_sea_step when fjord_near_low and sea_rising and sea_well_above_fjord goto LowRefill;
        edge u_sea_step when fjord_near_low and not (sea_rising and sea_well_above_fjord) goto LowConserve;
end

// -----------------------------------------------------------------------------
// Policy-based opening bands.
// -----------------------------------------------------------------------------

requirement invariant not (
    hydraulic_policy.LowConserve and fjord_water_level.total_open > 2
);

requirement invariant not (
    hydraulic_policy.HighProtect and fjord_water_level.total_open > 1
);

requirement invariant not (
    hydraulic_policy.LowRefill and phase.Env and fjord_water_level.total_open < 2
);

requirement invariant not (
    hydraulic_policy.HighDrain and phase.Env and fjord_water_level.total_open < 2
);

requirement invariant not (hydraulic_policy.LowRefill and Gate1.h > 1);
requirement invariant not (hydraulic_policy.LowRefill and Gate2.h > 1);
requirement invariant not (hydraulic_policy.LowRefill and Gate3.h > 1);
requirement invariant not (hydraulic_policy.LowRefill and Gate4.h > 1);

requirement invariant not (hydraulic_policy.HighDrain and Gate1.h > 1);
requirement invariant not (hydraulic_policy.HighDrain and Gate2.h > 1);
requirement invariant not (hydraulic_policy.HighDrain and Gate3.h > 1);
requirement invariant not (hydraulic_policy.HighDrain and Gate4.h > 1);

requirement Gate1.c_gate_rise  needs not (hydraulic_policy.LowConserve or hydraulic_policy.HighProtect);
requirement Gate2.c_gate_rise  needs not (hydraulic_policy.LowConserve or hydraulic_policy.HighProtect);
requirement Gate3.c_gate_rise  needs not (hydraulic_policy.LowConserve or hydraulic_policy.HighProtect);
requirement Gate4.c_gate_rise  needs not (hydraulic_policy.LowConserve or hydraulic_policy.HighProtect);

requirement Gate1.c_gate_lower needs not (hydraulic_policy.LowRefill or hydraulic_policy.HighDrain);
requirement Gate2.c_gate_lower needs not (hydraulic_policy.LowRefill or hydraulic_policy.HighDrain);
requirement Gate3.c_gate_lower needs not (hydraulic_policy.LowRefill or hydraulic_policy.HighDrain);
requirement Gate4.c_gate_lower needs not (hydraulic_policy.LowRefill or hydraulic_policy.HighDrain);

requirement invariant not (fjord_force_high_close and Gate1.h > 0);
requirement invariant not (fjord_force_high_close and Gate2.h > 0);
requirement invariant not (fjord_force_high_close and Gate3.h > 0);
requirement invariant not (fjord_force_high_close and Gate4.h > 0);

// -----------------------------------------------------------------------------
// L1/L2: Fjord level bounds.
// -----------------------------------------------------------------------------

requirement invariant fjord_water_level.lvl <= 4000;
requirement invariant fjord_water_level.lvl >= 1000;

// -----------------------------------------------------------------------------
// S1: Ships may only be allowed when the generated flow is small enough.
// With the current plant, this is modeled by constraining the sign.
// -----------------------------------------------------------------------------

requirement c_ship_green needs ship_flow_safe;
requirement invariant not (ships.green and not ship_flow_safe);
// -----------------------------------------------------------------------------
// S2 is still not formalized here.
// Reason: with only a red/green sign state and no ship request / waiting notion,
// "allowed once in a while" is not a well-posed supervisory requirement.
// It can be discussed in the report as a plant-model assumption/limitation.
// -----------------------------------------------------------------------------



