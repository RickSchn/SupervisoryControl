uncontrollable u_sea_step, u_gate_move_step;
controllable event int c_gate_start;


plant sea_level:
    // Sea level in mm.
    // 10-minute sampled approximation of:
    // ls(t) = 2500 - 2500 * sin(4*pi*t / 86400)
    //
    // Encoded only by location, to avoid a separate 0..5000 state variable.
    alg int current_water_level =
        if S0: 2500
        elif S1: 2282
        elif S2: 2066
        elif S3: 1853
        elif S4: 1645
        elif S5: 1443
        elif S6: 1250
        elif S7: 1066
        elif S8: 893
        elif S9: 732
        elif S10: 585
        elif S11: 452
        elif S12: 335
        elif S13: 234
        elif S14: 151
        elif S15: 85
        elif S16: 38
        elif S17: 10
        elif S18: 0
        elif S19: 10
        elif S20: 38
        elif S21: 85
        elif S22: 151
        elif S23: 234
        elif S24: 335
        elif S25: 452
        elif S26: 585
        elif S27: 732
        elif S28: 893
        elif S29: 1066
        elif S30: 1250
        elif S31: 1443
        elif S32: 1645
        elif S33: 1853
        elif S34: 2066
        elif S35: 2282
        elif S36: 2500
        elif S37: 2718
        elif S38: 2934
        elif S39: 3147
        elif S40: 3355
        elif S41: 3557
        elif S42: 3750
        elif S43: 3934
        elif S44: 4107
        elif S45: 4268
        elif S46: 4415
        elif S47: 4548
        elif S48: 4665
        elif S49: 4766
        elif S50: 4849
        elif S51: 4915
        elif S52: 4962
        elif S53: 4990
        elif S54: 5000
        elif S55: 4990
        elif S56: 4962
        elif S57: 4915
        elif S58: 4849
        elif S59: 4766
        elif S60: 4665
        elif S61: 4548
        elif S62: 4415
        elif S63: 4268
        elif S64: 4107
        elif S65: 3934
        elif S66: 3750
        elif S67: 3557
        elif S68: 3355
        elif S69: 3147
        elif S70: 2934
        else 2718
        end;

    location S0:
        initial;
        marked;
        edge u_sea_step goto S1;

    location S1:
        marked;
        edge u_sea_step goto S2;

    location S2:
        marked;
        edge u_sea_step goto S3;

    location S3:
        marked;
        edge u_sea_step goto S4;

    location S4:
        marked;
        edge u_sea_step goto S5;

    location S5:
        marked;
