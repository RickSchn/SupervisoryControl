plant ships: // Maybe change to requests, not necessary

    location red:
        initial;
        edge c_ship_green goto green;

    location green:
        marked;
        edge c_ship_red goto red;
end


plant rain: //increase to high levels
    const int rain_flow = 10;
    disc int[0..100] current_rain_flow = 0;

    location Dry:
        initial;
        marked;
        edge u_start_rain do current_rain_flow := rain_flow goto Rain;

    location Rain:
        marked;
        edge u_stop_rain do current_rain_flow := 0 goto Dry;
end


plant fjord_water_level:
    disc int[0..6000] lvl = 2000;

    const int gate_coeff = 20; // mm omzet naar m^3/s
    alg bool pos_flow = sea_level.current_water_level > lvl;
    alg bool neg_flow = sea_level.current_water_level < lvl;
    alg bool no_flow  = sea_level.current_water_level = lvl;
    alg int total_open = Gate1.h + Gate2.h + Gate3.h + Gate4.h;
    alg int gate_flow = total_open * gate_coeff;
    alg int rain_flow = rain.current_rain_flow;

    location:
        initial;
        marked;

        edge u_sea_step when pos_flow
            do lvl := lvl + rain_flow + gate_flow;

        edge u_sea_step when neg_flow
            do lvl := lvl + rain_flow - gate_flow;

        edge u_sea_step when no_flow
            do lvl := lvl + rain_flow;
end

alg bool no_gate_start_pending =
    not (Gate1.Opening or Gate1.Closing or
         Gate2.Opening or Gate2.Closing or
         Gate3.Opening or Gate3.Closing or
         Gate4.Opening or Gate4.Closing);

plant phase:
    location Decide:
        marked;
        initial;

        // Controllable commands.
        edge Gate1.c_gate_rise;
        edge Gate1.c_gate_lower;
        edge Gate2.c_gate_rise;
        edge Gate2.c_gate_lower;
        edge Gate3.c_gate_rise;
        edge Gate3.c_gate_lower;
        edge Gate4.c_gate_rise;
        edge Gate4.c_gate_lower;
        edge c_ship_green;
        edge c_ship_red;

        // Uncontrollable events that may still happen during the decision phase.
        edge Gate1.u_gate_step;
        edge Gate2.u_gate_step;
        edge Gate3.u_gate_step;
        edge Gate4.u_gate_step;

        edge u_start_rain;
        edge u_stop_rain;

        // End the decision phase once no gate is still waiting for its 5 s start step.
        edge c_end_cycle when no_gate_start_pending goto Env;

    location Env:
        marked;

        // Rain may also change here.
        edge u_start_rain;
        edge u_stop_rain;

        // One 3-minute environmental step, then back to decisions.
        edge u_sea_step goto Decide;
end

