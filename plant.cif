// ============================================================================
// Storm Surge Barrier - Uncontrolled Plant Model
// Hvide Sande, Denmark (4SC080 Assignment 2025-2026)
// ============================================================================

// --- Sea Water Level ---
// Tidal cycle abstracted as deterministic sequence through discrete levels.
// ls in {0,1,2,3,4,5} where each unit represents 1 meter.
// One full cycle: 0 -> 1 -> 2 -> 3 -> 4 -> 5 -> 4 -> 3 -> 2 -> 1 -> 0
// Based on equation (1): ls = A - A*sin(...), A=2.5, range [0.0, 5.0]m.
plant sea_level:
    uncontrollable u_sea_tick;
    controllable c_storm_prepare;
    disc int[0..5] ls = 0;

    location Rising0:  initial; marked; edge u_sea_tick do ls := 1 goto Rising1;
    location Rising1:  marked;         edge u_sea_tick do ls := 2 goto Rising2;
    location Rising2:  marked;         edge u_sea_tick do ls := 3 goto Rising3;
    location Rising3:  marked;         edge u_sea_tick do ls := 4 goto Rising4;
    // Storm warning: sea reaches ls=4, then pauses for the supervisor to
    // prepare (close gates). c_storm_prepare advances ls to 5.
    // StormWarning is NOT marked: the supervisor must eventually proceed.
    location Rising4:  marked;         edge u_sea_tick goto StormWarning;
    location StormWarning:             edge c_storm_prepare do ls := 5 goto Falling5;
    location Falling5: marked;         edge u_sea_tick do ls := 4 goto Falling4;
    location Falling4: marked;         edge u_sea_tick do ls := 3 goto Falling3;
    location Falling3: marked;         edge u_sea_tick do ls := 2 goto Falling2;
    location Falling2: marked;         edge u_sea_tick do ls := 1 goto Falling1;
    location Falling1: marked;         edge u_sea_tick do ls := 0 goto Rising0;
end

// --- Gate Actuator ---
// Each gate has 3 discrete positions: Closed (0m), Halfway (3m), Open (6m).
// Controllable events = motor commands. Transitions are instantaneous at
// the discrete time scale (gate actuation is minutes vs hours for level changes).
// c_close_all is a shared event: when it fires, ALL gates close atomically.
// This models emergency storm surge closure.
controllable c_close_all;

plant def Gate():
    controllable c_raise, c_lower;

    location Closed:
        initial; marked;
        edge c_raise goto Halfway;
        edge c_close_all;
    location Halfway:
        marked;
        edge c_raise goto Open;
        edge c_lower goto Closed;
        edge c_close_all goto Closed;
    location Open:
        marked;
        edge c_lower goto Halfway;
        edge c_close_all goto Closed;
end

Gate1: Gate();
Gate2: Gate();
Gate3: Gate();
Gate4: Gate();

// --- Fjord Water Level ---
// lf in {0,1,2,3,4,5} where each unit represents 1 meter.
// Rises due to rain inflow, falls due to gate outflow (when lf > ls and gates open).
// Fjord level changes are synchronized with the tidal clock (u_sea_tick).
// On each tick, exactly one outcome occurs based on gate state (deterministic):
//   - Raining + all gates closed => fjord rises (rain inflow, no drainage)
//   - Gates open + lf > ls       => fjord falls (gravitational discharge)
//   - Otherwise                  => fjord unchanged
// The supervisor controls the outcome by choosing gate positions between ticks.
plant fjord_level:
    disc int[0..5] lf = 2;

    // Any gate not fully closed
    alg bool any_gate_open = Gate1.Halfway or Gate1.Open
                          or Gate2.Halfway or Gate2.Open
                          or Gate3.Halfway or Gate3.Open
                          or Gate4.Halfway or Gate4.Open;

    // Water drains from fjord to sea when gates are open and fjord is higher
    alg bool draining = any_gate_open and lf > sea_level.ls;

    location:
        initial; marked;
        edge sea_level.u_sea_tick when rain.Raining and not any_gate_open and lf < 5 do lf := lf + 1;
        edge sea_level.u_sea_tick when draining and lf > 0 do lf := lf - 1;
        edge sea_level.u_sea_tick when not (rain.Raining and not any_gate_open and lf < 5)
                                   and not (draining and lf > 0);
end

// --- Turn-Based Clock ---
// After each u_sea_tick (which updates sea + fjord levels), the system pauses.
// Only controllable events fire during Supervisor turn. The supervisor adjusts
// gate positions, then issues c_react to allow the next tick.
// Supervisor location is NOT marked: the supervisor must eventually react.
plant turn:
    controllable c_react;

    location Environment:
        initial; marked;
        edge sea_level.u_sea_tick goto Supervisor;
    location Supervisor:
        edge c_react goto Environment;
end

// --- Rain ---
// Rain changes are synchronized with the sea tick (one possible change per tick).
plant rain:
    uncontrollable u_rain_start, u_rain_stop;

    location Dry:
        initial; marked;
        edge u_rain_start goto Raining;
    location Raining:
        marked;
        edge u_rain_stop goto Dry;
end

// --- Gate Actuation Timer ---
// Timer starts on any gate RAISE command and expires independently.
// Only c_raise is rate-limited; c_lower (closing) is always allowed
// for safety-critical storm surge protection.
plant gate_timer:
    uncontrollable u_timer_done;

    location Ready:
        initial; marked;
        edge Gate1.c_raise,
             Gate2.c_raise,
             Gate3.c_raise,
             Gate4.c_raise goto Cooldown;
    location Cooldown:
        edge u_timer_done goto Ready;
end

// --- Ship Sign ---
// Controllable sign at each harbor entrance. Ships may only enter when sign is Go.
plant def ShipSign():
    controllable c_sign_stop, c_sign_go;

    location Stop:
        initial; marked;
        edge c_sign_go goto Go;
    location Go:
        edge c_sign_stop goto Stop;
end

SignNorth: ShipSign();
SignSouth: ShipSign();

// --- Ships ---
// Ships arrive uncontrollably at harbor, wait for sign, pass through canal, then leave.
// One ship model per harbor for modularity.
plant def Ship(alg bool sign_is_go):
    uncontrollable u_ship_arrive, u_ship_pass, u_ship_leave;

    location NoShip:
        initial; marked;
        edge u_ship_arrive goto Waiting;
    location Waiting:
        // Ship can only pass when the sign allows it.
        edge u_ship_pass when sign_is_go goto Passing;
    location Passing:
        edge u_ship_leave goto NoShip;
end

ShipNorth: Ship(SignNorth.Go);
ShipSouth: Ship(SignSouth.Go);

// ============================================================================
// Requirements
// ============================================================================

// --- G1: Gates must close when sea level >= 5 (storm surge) ---
requirement invariant G1:
    sea_level.ls >= 5 => Gate1.Closed and Gate2.Closed and Gate3.Closed and Gate4.Closed;

// --- G2: Gates at most halfway when fjord level is in normal range ---
// Normal range: lf in {2, 3} (not near critical thresholds 1 or 4).
requirement invariant G2:
    (fjord_level.lf >= 2 and fjord_level.lf <= 3) =>
        not Gate1.Open and not Gate2.Open and not Gate3.Open and not Gate4.Open;

// --- G3: Gate actuation interval (timer cooldown) ---
// After any gate raise, wait for timer to expire before next raise.
// Closing (c_lower) is unrestricted for safety-critical storm protection.
requirement gate_interval:
    location Ready:
        initial; marked;
        edge Gate1.c_raise,
             Gate2.c_raise,
             Gate3.c_raise,
             Gate4.c_raise goto Cooldown;
    location Cooldown:
        edge gate_timer.u_timer_done goto Ready;
end

// --- L1: Fjord level must not exceed 4 ---
requirement invariant L1:
    fjord_level.lf <= 4;

// --- L2: Fjord level must not fall below 1 ---
requirement invariant L2:
    fjord_level.lf >= 1;

// --- S1: Ships only allowed when flow is safe (< 100 m3/s) ---
// Flow Q = c1 * h_i per gate, c1 = 5 m2/s.
// Gate openings: Closed=0m, Halfway=3m, Open=6m.
// Total flow = 5 * total_opening. Safe when < 100, i.e. total_opening < 20.
alg int total_opening = (if Gate1.Open: 6 elif Gate1.Halfway: 3 else 0 end)
                      + (if Gate2.Open: 6 elif Gate2.Halfway: 3 else 0 end)
                      + (if Gate3.Open: 6 elif Gate3.Halfway: 3 else 0 end)
                      + (if Gate4.Open: 6 elif Gate4.Halfway: 3 else 0 end);
alg bool flow_safe = sea_level.ls = fjord_level.lf or total_opening * 5 < 100;

// Signs may only show Go when flow is safe.
requirement invariant S1_north:
    SignNorth.Go => flow_safe;
requirement invariant S1_south:
    SignSouth.Go => flow_safe;

// --- S2: Ships must be allowed eventually (liveness) ---
// Handled by nonblocking synthesis: NoShip is the only marked location for ships,
// so the supervisor must ensure every reachable state can reach NoShip.
