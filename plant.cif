uncontrollable u_sea_step,
               u_g1_gap_done, u_g2_gap_done, u_g3_gap_done, u_g4_gap_done,
               u_g1_move_step, u_g2_move_step, u_g3_move_step, u_g4_move_step,
               u_ship_request, u_ship_passed,
               u_start_rain, u_stop_rain;

controllable c_g1_rise, c_g1_lower,
             c_g2_rise, c_g2_lower,
             c_g3_rise, c_g3_lower,
             c_g4_rise, c_g4_lower,
             c_ship_allow, c_ship_wait,
             c_end_cycle;


// Gate actuators with gate-specific 5 s completion and gate-specific move completion.
plant def gate_actuators(event rise_evt, lower_evt, gap_evt, move_evt):
    disc int[0..6] h = 0;

    location Idle:
        initial;
        marked;
        edge rise_evt  when h < 6 goto WaitUp;
        edge lower_evt when h > 0 goto WaitDown;

    location WaitUp:
        edge gap_evt goto MovingUp;

    location WaitDown:
        edge gap_evt goto MovingDown;

    location MovingUp:
        edge move_evt do h := h + 3 goto Idle;

    location MovingDown:
        edge move_evt do h := h - 3 goto Idle;
end

Gate1: gate_actuators(c_g1_rise, c_g1_lower, u_g1_gap_done, u_g1_move_step);
Gate2: gate_actuators(c_g2_rise, c_g2_lower, u_g2_gap_done, u_g2_move_step);
Gate3: gate_actuators(c_g3_rise, c_g3_lower, u_g3_gap_done, u_g3_move_step);
Gate4: gate_actuators(c_g4_rise, c_g4_lower, u_g4_gap_done, u_g4_move_step);


// Start coordinator: after any gate start, another start is blocked until the
// corresponding gate-specific 5 s completion event occurs.
plant gate_start_interval:
    location Ready:
        initial;
        marked;
        edge c_g1_rise  goto G1Wait;
        edge c_g1_lower goto G1Wait;
        edge c_g2_rise  goto G2Wait;
        edge c_g2_lower goto G2Wait;
        edge c_g3_rise  goto G3Wait;
        edge c_g3_lower goto G3Wait;
        edge c_g4_rise  goto G4Wait;
        edge c_g4_lower goto G4Wait;

    location G1Wait:
        edge u_g1_gap_done goto Ready;

    location G2Wait:
        edge u_g2_gap_done goto Ready;

    location G3Wait:
        edge u_g3_gap_done goto Ready;

    location G4Wait:
        edge u_g4_gap_done goto Ready;
end


alg bool all_gates_idle =
    Gate1.Idle and Gate2.Idle and Gate3.Idle and Gate4.Idle;


// Phase automaton:
// - In Decide: controller may issue commands and gate internal progress may finish.
// - c_end_cycle commits the decision phase once all gates are idle.
// - In Env: the uncontrollable sea step happens exactly once, then we return to Decide.
plant phase:
    location Decide:
        initial;
        marked;

        // Gate commands.
        edge c_g1_rise;
        edge c_g1_lower;
        edge c_g2_rise;
        edge c_g2_lower;
        edge c_g3_rise;
        edge c_g3_lower;
        edge c_g4_rise;
        edge c_g4_lower;

        // Gate internal progress.
        edge u_g1_gap_done;
        edge u_g2_gap_done;
        edge u_g3_gap_done;
        edge u_g4_gap_done;
        edge u_g1_move_step;
        edge u_g2_move_step;
        edge u_g3_move_step;
        edge u_g4_move_step;

        // Ships.
        edge u_ship_request;
        edge c_ship_allow;
        edge c_ship_wait;
        edge u_ship_passed;

        // Rain may change at any time.
        edge u_start_rain;
        edge u_stop_rain;

        // End decision phase only when all gates are idle.
        edge c_end_cycle when all_gates_idle goto Env;

    location Env:
        marked;

        // Rain may also change here.
        edge u_start_rain;
        edge u_stop_rain;

        // Exactly one environmental sea update.
        edge u_sea_step goto Decide;
end


// Coarser sea model: 36-step cycle (20-minute samples over a 12-hour tide period).
plant sea_level:
    alg int current_water_level =
        if S0: 2500
        elif S1: 2066
        elif S2: 1645
        elif S3: 1250
        elif S4: 893
        elif S5: 585
        elif S6: 335
        elif S7: 151
        elif S8: 38
        elif S9: 0
        elif S10: 38
        elif S11: 151
        elif S12: 335
        elif S13: 585
        elif S14: 893
        elif S15: 1250
        elif S16: 1645
        elif S17: 2066
        elif S18: 2500
        elif S19: 2934
        elif S20: 3355
        elif S21: 3750
        elif S22: 4107
        elif S23: 4415
        elif S24: 4665
        elif S25: 4849
        elif S26: 4962
        elif S27: 5000
        elif S28: 4962
        elif S29: 4849
        elif S30: 4665
        elif S31: 4415
        elif S32: 4107
        elif S33: 3750
        elif S34: 3355
        else 2934
        end;

    location S0:
        initial;
        marked;
        edge u_sea_step goto S1;

    location S1:
        marked;
        edge u_sea_step goto S2;

    location S2:
        marked;
        edge u_sea_step goto S3;

    location S3:
        marked;
        edge u_sea_step goto S4;

    location S4:
        marked;
        edge u_sea_step goto S5;

    location S5:
        marked;
        edge u_sea_step goto S6;

    location S6:
        marked;
        edge u_sea_step goto S7;

    location S7:
        marked;
        edge u_sea_step goto S8;

    location S8:
        marked;
        edge u_sea_step goto S9;

    location S9:
        marked;
        edge u_sea_step goto S10;

    location S10:
        marked;
        edge u_sea_step goto S11;

    location S11:
        marked;
        edge u_sea_step goto S12;

    location S12:
        marked;
        edge u_sea_step goto S13;

    location S13:
        marked;
        edge u_sea_step goto S14;

    location S14:
        marked;
        edge u_sea_step goto S15;

    location S15:
        marked;
        edge u_sea_step goto S16;

    location S16:
        marked;
        edge u_sea_step goto S17;

    location S17:
        marked;
        edge u_sea_step goto S18;

    location S18:
        marked;
        edge u_sea_step goto S19;

    location S19:
        marked;
        edge u_sea_step goto S20;

    location S20:
        marked;
        edge u_sea_step goto S21;

    location S21:
        marked;
        edge u_sea_step goto S22;

    location S22:
        marked;
        edge u_sea_step goto S23;

    location S23:
        marked;
        edge u_sea_step goto S24;

    location S24:
        marked;
        edge u_sea_step goto S25;

    location S25:
        marked;
        edge u_sea_step goto S26;

    location S26:
        marked;
        edge u_sea_step goto S27;

    location S27:
        marked;
        edge u_sea_step goto S28;

    location S28:
        marked;
        edge u_sea_step goto S29;

    location S29:
        marked;
        edge u_sea_step goto S30;

    location S30:
        marked;
        edge u_sea_step goto S31;

    location S31:
        marked;
        edge u_sea_step goto S32;

    location S32:
        marked;
        edge u_sea_step goto S33;

    location S33:
        marked;
        edge u_sea_step goto S34;

    location S34:
        marked;
        edge u_sea_step goto S35;

    location S35:
        marked;
        edge u_sea_step goto S0;
end


plant ships:
    location Idle:
        initial;
        marked;
        edge u_ship_request goto Waiting;

    location Waiting:
        marked;
        edge c_ship_allow goto Passing;
        edge c_ship_wait;

    location Passing:
        marked;
        edge u_ship_passed goto Idle;
end


plant rain:
    const int rain_flow = 10;
    disc int[0..10] current_rain_flow = 0;

    location Dry:
        initial;
        marked;
        edge u_start_rain do current_rain_flow := rain_flow goto Rain;

    location Rain:
        marked;
        edge u_stop_rain do current_rain_flow := 0 goto Dry;
end


plant fjord_water_level:
    disc int[0..6000] lvl = 2000;

    alg bool pos_flow = sea_level.current_water_level > lvl;
    alg bool neg_flow = sea_level.current_water_level < lvl;
    alg bool no_flow  = sea_level.current_water_level = lvl;
    alg int total_open = Gate1.h + Gate2.h + Gate3.h + Gate4.h;
    alg int rain_flow = rain.current_rain_flow;

    location:
        initial;
        marked;

        edge u_sea_step when pos_flow
            do lvl := lvl + rain_flow + total_open;

        edge u_sea_step when neg_flow
            do lvl := lvl + rain_flow - total_open;

        edge u_sea_step when no_flow
            do lvl := lvl + rain_flow;
end
