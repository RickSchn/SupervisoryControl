end

plant def gate_actuators(alg int id_gate):
    disc int[0..6] h = 0;

    location Idle:
        initial;
        marked;
        edge c_gate_start!id_gate  when h < 6 goto MovingUp;
        edge c_gate_start!-id_gate when h > 0 goto MovingDown;

    location MovingUp:
        edge u_gate_move_step do h := h + 3 goto Idle;

    location MovingDown:
        edge u_gate_move_step do h := h - 3 goto Idle;
end

Gate1: gate_actuators(1);
Gate2: gate_actuators(2);
Gate3: gate_actuators(3);
Gate4: gate_actuators(4);

plant ships:
    uncontrollable u_ship_request;
    controllable c_ship_allow, c_ship_wait;

    location Idle:
        initial;
        marked;
        edge u_ship_request goto Waiting;

    location Waiting:
        marked;
        edge c_ship_allow goto Passing;
        edge c_ship_wait  goto Waiting;

    location Passing:
        marked;
        edge u_sea_step goto Idle;
end

plant fjord_water_level:
    const int flow_max = 100;
    disc int[0..6000] lvl = 2000;

    alg bool pos_flow = sea_level.current_water_level > lvl;
    alg bool neg_flow = sea_level.current_water_level < lvl;
    alg bool no_flow  = sea_level.current_water_level = lvl;
    alg int total_open = Gate1.h + Gate2.h + Gate3.h + Gate4.h;
    alg bool flow_low = abs(total_open) < flow_max;
    alg int rain_flow = rain.current_rain_flow;

    location:
        initial;
        marked;
        edge u_sea_step when pos_flow
            do lvl := lvl + rain_flow + total_open;

        edge u_sea_step when neg_flow
            do lvl := lvl + rain_flow - total_open;

        edge u_sea_step when no_flow
            do lvl := lvl + rain_flow;
end

plant rain:
    uncontrollable u_stop_rain, u_start_rain;

    // Interpreted as mm added to fjord level per sea step while raining.
    const int rain_flow = 10;
    disc int[0..10] current_rain_flow = 0;

    location Dry:
        initial;
        marked;
        edge u_start_rain do current_rain_flow := rain_flow goto Rain;

    location Rain:
        marked;
        edge u_stop_rain do current_rain_flow := 0 goto Dry;
end
