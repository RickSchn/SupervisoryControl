uncontrollable u_unit_step_large, u_unit_step_medium, u_unit_step_small;
controllable c_gate_rise, c_gate_lower;

plant sea_level:
    disc list int water_level = [0, 100, 200, 300, 400, 500, 400, 300, 200, 100];
    disc int current_water_level;
    disc int counter = 0;

    location:
        initial;
        marked;
        edge u_unit_step_large when counter < 10 do current_water_level := water_level[counter], counter := counter+1;
        edge u_unit_step_large when counter = 10 do counter:= 1, current_water_level := water_level[0];

end


plant def gate_actuators():
    disc int h;

    location Idle:
        initial;
        marked;
        edge c_gate_rise when h<6 goto Opening;
        edge c_gate_lower when h>0 goto Closing;
    location Closing:
        edge u_unit_step_small do h:= h-3 goto Idle;
    location Opening:
        edge u_unit_step_small do h:= h+3 goto Idle;
end

Gate1: gate_actuators();
Gate2: gate_actuators();
Gate3: gate_actuators();
Gate4: gate_actuators();

plant unit_steps_check:
    location no_gates:
        initial;
        edge c_gate_rise goto gates;
        edge c_gate_lower goto gates;

    location gates:
        edge u_unit_step_medium goto no_gates;
end

const int flow_coeff_gates = 8;
alg int total_open = (Gate1.h+Gate2.h+Gate3.h+Gate4.h);
alg bool sea_to_fjord = sea_level.current_water_level > fjord_water_level.lvl;
alg int direction_flow = if sea_to_fjord = true: 1 else -1 end;
alg int flow_gates = flow_coeff_gates*total_open*direction_flow;

const int rain_flow = 50;
const int flow_max = 100;

const int high_flow_req = 100;
alg bool flow_low = flow_gates < flow_max;



plant ships:
    controllable c_ships_green, c_ships_red;

    location Green:
        marked;
        edge c_ships_red goto Red;

    location Red:
        initial;
        edge c_ships_green  goto Green;
end

plant fjord_water_level:
    uncontrollable u_stop_rain,u_start_rain;
    disc int lvl = 200;

    location Dry:
        initial;
        marked;
        edge u_unit_step_large   do lvl := lvl + flow_gates;
        edge u_start_rain   goto Rain;

    location Rain:
        marked;
        edge u_unit_step_large   do lvl := lvl + flow_gates + rain_flow;
        edge u_stop_rain    goto Dry;
end






