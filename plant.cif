uncontrollable u_sea_step, u_start_rain, u_stop_rain;

controllable c_ship_green, c_ship_red, c_end_cycle;


// must work both ways when not near critical.
plant def gate_actuators():
    disc int[0..2] h = 0;
    controllable c_gate_rise, c_gate_lower;
    uncontrollable u_gate_step;

    location Idle:
        initial; marked;
        edge c_gate_rise when h < 2 goto Opening;
        edge c_gate_lower when h > 0 goto Closing;
        edge u_sea_step;
    location Closing:
        marked;                                     // otherwise supervisor removes access
        edge u_gate_step do h := h - 1 goto Moving;
    location Opening:
        marked;                                     // otherwise supervisor removes access
        edge u_gate_step do h := h + 1 goto Moving;
    location Moving:
        marked;                                     // otherwise supervisor removes access
        edge u_sea_step goto Idle;
end

Gate1: gate_actuators();
Gate2: gate_actuators();
Gate3: gate_actuators();
Gate4: gate_actuators();

alg bool all_gates_idle =
    Gate1.Idle and Gate2.Idle and Gate3.Idle and Gate4.Idle;
