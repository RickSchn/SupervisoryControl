plant sea_level:
    uncontrollable u_sea_rise, u_sea_lower;
    disc int ls = 0;
    location Low:
        initial;
        marked;
        edge u_sea_rise when ls < 4 do ls:= ls + 1;
        edge u_sea_rise when ls = 4 do ls:= ls + 1 goto High;
    location High:
        marked;
        edge u_sea_lower when ls > 1 do ls:= ls - 1;
        edge u_sea_lower when ls = 1 do ls:= ls - 1 goto Low;
end


plant def gate_actuators():
    controllable c_gate_rise, c_gate_lower,c_gate_stop;
    disc int h;
    location Idle:

        initial;
        marked;
        edge c_gate_rise when h<6 goto Opening;
        edge c_gate_lower when h>0 goto Closing;
    location Closing:
        edge c_gate_stop do h:= h-3 goto Idle;
    location Opening:
        edge c_gate_stop do h:= h+3 goto Idle;
end

Gate1: gate_actuators();
Gate2: gate_actuators();
Gate3: gate_actuators();
Gate4: gate_actuators();




plant rain:
    uncontrollable u_stop_rain,u_start_rain;
    disc int R;
    location Dry:
        initial;
        marked;
        edge u_start_rain do R:= 1 goto Rain;
    location Rain:
        marked;
        edge u_stop_rain do R:= 0 goto Dry;
end





