plant automaton ships:
  location Idle:
    initial;
    marked;
    edge u_ship_request goto Waiting;
  location Waiting:
    marked;
    edge c_ship_allow goto Passing;
    edge c_ship_wait;
  location Passing:
    marked;
    edge u_ship_passed goto Idle;
end
plant automaton rain:
  const int[10..10] rain_flow = 10;
  disc int[0..10] current_rain_flow = 0;
  location Dry:
    initial;
    marked;
    edge u_start_rain do current_rain_flow := rain_flow goto Rain;
  location Rain:
    marked;
    edge u_stop_rain do current_rain_flow := 0 goto Dry;
end
plant automaton fjord_water_level:
  disc int[0..6000] lvl = 2000;
  alg bool pos_flow = sea_level.current_water_level > lvl;
  alg bool neg_flow = sea_level.current_water_level < lvl;
  alg bool no_flow = sea_level.current_water_level = lvl;
  alg int[0..24] total_open = Gate1.h + Gate2.h + Gate3.h + Gate4.h;
  alg int[0..10] rain_flow = rain.current_rain_flow;
  location:
    initial;
    marked;
    edge u_sea_step when pos_flow do lvl := lvl + rain_flow + total_open;
    edge u_sea_step when neg_flow do lvl := lvl + rain_flow - total_open;
    edge u_sea_step when no_flow do lvl := lvl + rain_flow;
end
supervisor automaton sup:
  alphabet c_g1_rise, c_g1_lower, c_g2_rise, c_g2_lower, c_g3_rise, c_g3_lower, c_g4_rise, c_g4_lower, c_ship_allow, c_ship_wait, c_end_cycle;
  location:
    initial;
    marked;
    edge c_end_cycle when bdd_eval(363, bdd_values);
    edge c_g1_lower when bdd_eval(44, bdd_values);
    edge c_g1_rise when bdd_eval(0, bdd_values);
    edge c_g2_lower when bdd_eval(95, bdd_values);
    edge c_g2_rise when bdd_eval(48, bdd_values);
    edge c_g3_lower when bdd_eval(200, bdd_values);
    edge c_g3_rise when bdd_eval(153, bdd_values);
    edge c_g4_lower when bdd_eval(305, bdd_values);
    edge c_g4_rise when bdd_eval(258, bdd_values);
    edge c_ship_allow when true;
    edge c_ship_wait when true;
end
supervisor invariant not(sea_preclose_zone and Gate1.h = 6);
supervisor invariant not(sea_preclose_zone and Gate2.h = 6);
supervisor invariant not(sea_preclose_zone and Gate3.h = 6);
supervisor invariant not(sea_preclose_zone and Gate4.h = 6);
supervisor invariant not(sea_close_zone and Gate1.h > 0);
supervisor invariant not(sea_close_zone and Gate2.h > 0);
supervisor invariant not(sea_close_zone and Gate3.h > 0);
supervisor invariant not(sea_close_zone and Gate4.h > 0);
supervisor invariant not(fjord_noncritical and Gate1.h = 6);
supervisor invariant not(fjord_noncritical and Gate2.h = 6);
supervisor invariant not(fjord_noncritical and Gate3.h = 6);
supervisor invariant not(fjord_noncritical and Gate4.h = 6);
supervisor invariant fjord_water_level.lvl <= 4000;
supervisor invariant fjord_water_level.lvl >= 1000;
