alg bool fjord_near_low = fjord_water_level.lvl <= 1500;
alg bool fjord_near_high = fjord_water_level.lvl >= 3500;
alg bool fjord_noncritical = not(fjord_near_low or fjord_near_high);
alg bool sea_rising = sea_level.k >= 60 and sea_level.k < 180;
alg bool sea_falling = not sea_rising;
alg bool sea_can_refill_fjord = sea_level.current_water_level >= fjord_water_level.lvl;
alg bool sea_can_drain_fjord = sea_level.current_water_level <= fjord_water_level.lvl;
alg bool low_close_regime = fjord_near_low and (sea_falling or not sea_can_refill_fjord);
alg bool high_close_regime = fjord_near_high and (sea_rising or not sea_can_drain_fjord);
alg bool low_open_regime = fjord_near_low and sea_rising and sea_can_refill_fjord;
alg bool high_open_regime = fjord_near_high and sea_falling and sea_can_drain_fjord;
alg bool close_regime = low_close_regime or high_close_regime;
alg bool open_regime = low_open_regime or high_open_regime;
alg bool sea_close_zone = sea_level.current_water_level > 4500;
alg bool sea_preclose_zone = sea_level.current_water_level >= 4443;
alg bool ship_flow_safe = abs(fjord_water_level.gate_flow) <= 100;
uncontrollable u_sea_step;
uncontrollable u_start_rain;
uncontrollable u_stop_rain;
controllable c_ship_green;
controllable c_ship_red;
controllable c_end_cycle;
alg bool all_gates_idle = Gate1.Idle and Gate2.Idle and Gate3.Idle and Gate4.Idle;
alg bool no_gate_start_pending = not(Gate1.Opening or Gate1.Closing or Gate2.Opening or Gate2.Closing or Gate3.Opening or Gate3.Closing or Gate4.Opening or Gate4.Closing);
