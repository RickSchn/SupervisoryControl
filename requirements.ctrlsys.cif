alg list[54] bool bdd_values = [bdd_value0, bdd_value1, bdd_value2, bdd_value3, bdd_value4, bdd_value5, bdd_value6, bdd_value7, bdd_value8, bdd_value9, bdd_value10, bdd_value11, bdd_value12, bdd_value13, bdd_value14, bdd_value15, bdd_value16, bdd_value17, bdd_value18, bdd_value19, bdd_value20, bdd_value21, bdd_value22, bdd_value23, bdd_value24, bdd_value25, bdd_value26, bdd_value27, bdd_value28, bdd_value29, bdd_value30, bdd_value31, bdd_value32, bdd_value33, bdd_value34, bdd_value35, bdd_value36, bdd_value37, bdd_value38, bdd_value39, bdd_value40, bdd_value41, bdd_value42, bdd_value43, bdd_value44, bdd_value45, bdd_value46, bdd_value47, bdd_value48, bdd_value49, bdd_value50, bdd_value51, bdd_value52, bdd_value53];
func bool bdd_eval(int idx; list[54] bool values):
  bdd_node_type node;
  bool val;
  while idx >= 0:
    node := bdd_nodes[idx];
    val := values[node[var]];
    idx := if val: node[high] else node[low] end;
  end
  return idx = -1;
end
supervisor automaton req_no_rise_in_preclose:
  location Ok:
    initial;
    marked;
    edge c_g1_rise when not sea_preclose_zone;
    edge c_g2_rise when not sea_preclose_zone;
    edge c_g3_rise when not sea_preclose_zone;
    edge c_g4_rise when not sea_preclose_zone;
end
plant automaton Gate1:
  disc int[0..6] h = 0;
  location Idle:
    initial;
    marked;
    edge c_g1_rise when h < 6 goto WaitUp;
    edge c_g1_lower when h > 0 goto WaitDown;
  location WaitUp:
    edge u_g1_gap_done goto MovingUp;
  location WaitDown:
    edge u_g1_gap_done goto MovingDown;
  location MovingUp:
    edge u_g1_move_step do h := h + 3 goto Idle;
  location MovingDown:
    edge u_g1_move_step do h := h - 3 goto Idle;
end
plant automaton Gate2:
  disc int[0..6] h = 0;
  location Idle:
    initial;
    marked;
    edge c_g2_rise when h < 6 goto WaitUp;
    edge c_g2_lower when h > 0 goto WaitDown;
  location WaitUp:
    edge u_g2_gap_done goto MovingUp;
  location WaitDown:
    edge u_g2_gap_done goto MovingDown;
  location MovingUp:
    edge u_g2_move_step do h := h + 3 goto Idle;
  location MovingDown:
    edge u_g2_move_step do h := h - 3 goto Idle;
end
plant automaton Gate3:
  disc int[0..6] h = 0;
  location Idle:
    initial;
    marked;
    edge c_g3_rise when h < 6 goto WaitUp;
    edge c_g3_lower when h > 0 goto WaitDown;
  location WaitUp:
    edge u_g3_gap_done goto MovingUp;
  location WaitDown:
    edge u_g3_gap_done goto MovingDown;
  location MovingUp:
    edge u_g3_move_step do h := h + 3 goto Idle;
  location MovingDown:
    edge u_g3_move_step do h := h - 3 goto Idle;
end
plant automaton Gate4:
  disc int[0..6] h = 0;
  location Idle:
    initial;
    marked;
    edge c_g4_rise when h < 6 goto WaitUp;
    edge c_g4_lower when h > 0 goto WaitDown;
  location WaitUp:
    edge u_g4_gap_done goto MovingUp;
  location WaitDown:
    edge u_g4_gap_done goto MovingDown;
  location MovingUp:
    edge u_g4_move_step do h := h + 3 goto Idle;
  location MovingDown:
    edge u_g4_move_step do h := h - 3 goto Idle;
end
plant automaton gate_start_interval:
  location Ready:
    initial;
    marked;
    edge c_g1_rise goto G1Wait;
    edge c_g1_lower goto G1Wait;
    edge c_g2_rise goto G2Wait;
    edge c_g2_lower goto G2Wait;
    edge c_g3_rise goto G3Wait;
    edge c_g3_lower goto G3Wait;
    edge c_g4_rise goto G4Wait;
    edge c_g4_lower goto G4Wait;
  location G1Wait:
    edge u_g1_gap_done goto Ready;
  location G2Wait:
    edge u_g2_gap_done goto Ready;
  location G3Wait:
    edge u_g3_gap_done goto Ready;
  location G4Wait:
    edge u_g4_gap_done goto Ready;
end
plant automaton phase:
  location Decide:
    initial;
    marked;
    edge c_g1_rise;
    edge c_g1_lower;
    edge c_g2_rise;
    edge c_g2_lower;
    edge c_g3_rise;
    edge c_g3_lower;
    edge c_g4_rise;
    edge c_g4_lower;
    edge u_g1_gap_done;
    edge u_g2_gap_done;
    edge u_g3_gap_done;
    edge u_g4_gap_done;
    edge u_g1_move_step;
    edge u_g2_move_step;
    edge u_g3_move_step;
    edge u_g4_move_step;
    edge u_ship_request;
    edge c_ship_allow;
    edge c_ship_wait;
    edge u_ship_passed;
    edge u_start_rain;
    edge u_stop_rain;
    edge c_end_cycle when all_gates_idle goto Env;
  location Env:
    marked;
    edge u_start_rain;
    edge u_stop_rain;
    edge u_sea_step goto Decide;
end
