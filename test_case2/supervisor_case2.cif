end
plant automaton ships:
  location red:
    initial;
    edge c_ship_green goto green;
  location green:
    marked;
    edge c_ship_red goto red;
end
plant automaton rain:
  location Dry:
    initial;
    marked;
    edge u_start_rain goto Rain;
  location Rain:
    marked;
    edge u_stop_rain goto Dry;
end
plant automaton fjord_water_level:
  disc int[900..4100] lvl = 3700;
  const int[20..20] gate_coeff = 20;
  alg bool pos_flow = sea_level.current_water_level > lvl;
  alg bool neg_flow = sea_level.current_water_level < lvl;
  alg bool no_flow = sea_level.current_water_level = lvl;
  alg int[0..8] total_open = Gate1.h + Gate2.h + Gate3.h + Gate4.h;
  alg int[0..160] gate_flow = total_open * gate_coeff;
  alg int[0..10] rain_flow = switch rain.Rain: case true: 10 else 0 end;
  location:
    initial;
    marked;
    edge u_sea_step when pos_flow do lvl := lvl + rain_flow + gate_flow;
    edge u_sea_step when neg_flow do lvl := lvl + rain_flow - gate_flow;
    edge u_sea_step when no_flow do lvl := lvl + rain_flow;
end
plant automaton phase:
  location Decide:
    initial;
    marked;
    edge Gate1.c_gate_rise;
    edge Gate1.c_gate_lower;
    edge Gate2.c_gate_rise;
    edge Gate2.c_gate_lower;
    edge Gate3.c_gate_rise;
    edge Gate3.c_gate_lower;
    edge Gate4.c_gate_rise;
    edge Gate4.c_gate_lower;
    edge c_ship_green;
    edge c_ship_red;
    edge Gate1.u_gate_step;
    edge Gate2.u_gate_step;
    edge Gate3.u_gate_step;
    edge Gate4.u_gate_step;
    edge u_start_rain;
    edge u_stop_rain;
    edge c_end_cycle when no_gate_start_pending goto Env;
  location Env:
    marked;
    edge u_start_rain;
    edge u_stop_rain;
    edge u_sea_step goto Decide;
end
supervisor automaton sup:
  alphabet Gate1.c_gate_rise, Gate1.c_gate_lower, Gate2.c_gate_rise, Gate2.c_gate_lower, Gate3.c_gate_rise, Gate3.c_gate_lower, Gate4.c_gate_rise, Gate4.c_gate_lower, c_ship_green, c_ship_red, c_end_cycle;
  location:
    initial;
    marked;
    edge c_end_cycle when bdd_eval(9118, bdd_values);
    edge c_ship_green when bdd_eval(6869, bdd_values);
    edge c_ship_red when true;
    edge Gate1.c_gate_lower when bdd_eval(1083, bdd_values);
    edge Gate1.c_gate_rise when bdd_eval(0, bdd_values);
    edge Gate2.c_gate_lower when bdd_eval(2900, bdd_values);
    edge Gate2.c_gate_rise when bdd_eval(1122, bdd_values);
    edge Gate3.c_gate_lower when bdd_eval(4818, bdd_values);
    edge Gate3.c_gate_rise when bdd_eval(2936, bdd_values);
    edge Gate4.c_gate_lower when bdd_eval(6830, bdd_values);
    edge Gate4.c_gate_rise when bdd_eval(4856, bdd_values);
end
supervisor invariant not(sea_close_zone and Gate1.h > 0);
supervisor invariant not(sea_close_zone and Gate2.h > 0);
supervisor invariant not(sea_close_zone and Gate3.h > 0);
supervisor invariant not(sea_close_zone and Gate4.h > 0);
supervisor invariant Gate1.c_gate_rise needs not(fjord_noncritical and Gate1.h >= 1);
supervisor invariant Gate2.c_gate_rise needs not(fjord_noncritical and Gate2.h >= 1);
supervisor invariant Gate3.c_gate_rise needs not(fjord_noncritical and Gate3.h >= 1);
supervisor invariant Gate4.c_gate_rise needs not(fjord_noncritical and Gate4.h >= 1);
supervisor invariant not(low_conserve_now and fjord_water_level.total_open > 2);
supervisor invariant not(high_protect_now and fjord_water_level.total_open > 1);
supervisor invariant not(low_refill_now and phase.Env and fjord_water_level.total_open < 2);
supervisor invariant not(high_drain_now and phase.Env and fjord_water_level.total_open < 2);
supervisor invariant not(low_refill_now and Gate1.h > 1);
supervisor invariant not(low_refill_now and Gate2.h > 1);
supervisor invariant not(low_refill_now and Gate3.h > 1);
supervisor invariant not(low_refill_now and Gate4.h > 1);
supervisor invariant not(high_drain_now and Gate1.h > 1);
supervisor invariant not(high_drain_now and Gate2.h > 1);
supervisor invariant not(high_drain_now and Gate3.h > 1);
supervisor invariant not(high_drain_now and Gate4.h > 1);
supervisor invariant Gate1.c_gate_rise needs not(low_conserve_now or high_protect_now);
supervisor invariant Gate2.c_gate_rise needs not(low_conserve_now or high_protect_now);
supervisor invariant Gate3.c_gate_rise needs not(low_conserve_now or high_protect_now);
supervisor invariant Gate4.c_gate_rise needs not(low_conserve_now or high_protect_now);
supervisor invariant Gate1.c_gate_lower needs not(low_refill_now or high_drain_now);
supervisor invariant Gate2.c_gate_lower needs not(low_refill_now or high_drain_now);
supervisor invariant Gate3.c_gate_lower needs not(low_refill_now or high_drain_now);
supervisor invariant Gate4.c_gate_lower needs not(low_refill_now or high_drain_now);
supervisor invariant not(fjord_force_high_close and Gate1.h > 0);
supervisor invariant not(fjord_force_high_close and Gate2.h > 0);
supervisor invariant not(fjord_force_high_close and Gate3.h > 0);
supervisor invariant not(fjord_force_high_close and Gate4.h > 0);
supervisor invariant fjord_water_level.lvl <= 4000;
supervisor invariant fjord_water_level.lvl >= 1000;
supervisor invariant c_ship_green needs ship_flow_safe;
supervisor invariant not(ships.green and not ship_flow_safe);
