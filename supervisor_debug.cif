alg bool bdd_value0 = fjord_water_level.lvl div 1 mod 2 > 0;
alg bool bdd_value1 = fjord_water_level.lvl div 2 mod 2 > 0;
alg bool bdd_value2 = fjord_water_level.lvl div 4 mod 2 > 0;
alg bool bdd_value3 = fjord_water_level.lvl div 8 mod 2 > 0;
alg bool bdd_value4 = fjord_water_level.lvl div 16 mod 2 > 0;
alg bool bdd_value5 = fjord_water_level.lvl div 32 mod 2 > 0;
alg bool bdd_value6 = fjord_water_level.lvl div 64 mod 2 > 0;
alg bool bdd_value7 = fjord_water_level.lvl div 128 mod 2 > 0;
alg bool bdd_value8 = fjord_water_level.lvl div 256 mod 2 > 0;
alg bool bdd_value9 = fjord_water_level.lvl div 512 mod 2 > 0;
alg bool bdd_value10 = fjord_water_level.lvl div 1024 mod 2 > 0;
alg bool bdd_value11 = fjord_water_level.lvl div 2048 mod 2 > 0;
alg bool bdd_value12 = fjord_water_level.lvl div 4096 mod 2 > 0;
alg bool bdd_value13 = Gate1.Closing or Gate1.Moving;
alg bool bdd_value14 = Gate1.Opening or Gate1.Moving;
alg bool bdd_value15 = Gate1.h div 1 mod 2 > 0;
alg bool bdd_value16 = Gate1.h div 2 mod 2 > 0;
alg bool bdd_value17 = Gate2.Closing or Gate2.Moving;
alg bool bdd_value18 = Gate2.Opening or Gate2.Moving;
alg bool bdd_value19 = Gate2.h div 1 mod 2 > 0;
alg bool bdd_value20 = Gate2.h div 2 mod 2 > 0;
alg bool bdd_value21 = Gate3.Closing or Gate3.Moving;
alg bool bdd_value22 = Gate3.Opening or Gate3.Moving;
alg bool bdd_value23 = Gate3.h div 1 mod 2 > 0;
alg bool bdd_value24 = Gate3.h div 2 mod 2 > 0;
alg bool bdd_value25 = Gate4.Closing or Gate4.Moving;
alg bool bdd_value26 = Gate4.Opening or Gate4.Moving;
alg bool bdd_value27 = Gate4.h div 1 mod 2 > 0;
alg bool bdd_value28 = Gate4.h div 2 mod 2 > 0;
alg bool bdd_value29 = gate_start_interval.Wait;
alg bool bdd_value30 = phase.Env;
alg bool bdd_value31 = rain.Rain;
alg bool bdd_value32 = sea_level.k div 1 mod 2 > 0;
alg bool bdd_value33 = sea_level.k div 2 mod 2 > 0;
alg bool bdd_value34 = sea_level.k div 4 mod 2 > 0;
alg bool bdd_value35 = sea_level.k div 8 mod 2 > 0;
alg bool bdd_value36 = sea_level.k div 16 mod 2 > 0;
alg bool bdd_value37 = sea_level.k div 32 mod 2 > 0;
alg bool bdd_value38 = sea_level.k div 64 mod 2 > 0;
alg bool bdd_value39 = sea_level.k div 128 mod 2 > 0;
alg bool bdd_value40 = ships.green;
alg list[41] bool bdd_values = [bdd_value0, bdd_value1, bdd_value2, bdd_value3, bdd_value4, bdd_value5, bdd_value6, bdd_value7, bdd_value8, bdd_value9, bdd_value10, bdd_value11, bdd_value12, bdd_value13, bdd_value14, bdd_value15, bdd_value16, bdd_value17, bdd_value18, bdd_value19, bdd_value20, bdd_value21, bdd_value22, bdd_value23, bdd_value24, bdd_value25, bdd_value26, bdd_value27, bdd_value28, bdd_value29, bdd_value30, bdd_value31, bdd_value32, bdd_value33, bdd_value34, bdd_value35, bdd_value36, bdd_value37, bdd_value38, bdd_value39, bdd_value40];
func bool bdd_eval(bdd_node_idx_type idx; list[41] bool values):
  bdd_node_type node;
  bool val;
  while idx >= 0:
    node := bdd_nodes[idx];
    val := values[node[var]];
    idx := if val: node[high] else node[low] end;
  end
  return idx = -1;
end
supervisor automaton req_no_rise_in_preclose:
  location Ok:
    initial;
    marked;
    edge Gate1.c_gate_rise when not sea_preclose_zone;
    edge Gate2.c_gate_rise when not sea_preclose_zone;
    edge Gate3.c_gate_rise when not sea_preclose_zone;
    edge Gate4.c_gate_rise when not sea_preclose_zone;
end
supervisor automaton gate_start_interval:
  location Ready:
    initial;
    marked;
    edge Gate1.c_gate_rise goto Wait;
    edge Gate1.c_gate_lower goto Wait;
    edge Gate2.c_gate_rise goto Wait;
    edge Gate2.c_gate_lower goto Wait;
    edge Gate3.c_gate_rise goto Wait;
    edge Gate3.c_gate_lower goto Wait;
    edge Gate4.c_gate_rise goto Wait;
    edge Gate4.c_gate_lower goto Wait;
    edge u_sea_step;
    edge u_start_rain;
    edge u_stop_rain;
    edge c_ship_green;
    edge c_ship_red;
  location Wait:
    marked;
    edge Gate1.u_gate_step goto Ready;
    edge Gate2.u_gate_step goto Ready;
    edge Gate3.u_gate_step goto Ready;
    edge Gate4.u_gate_step goto Ready;
    edge u_start_rain;
    edge u_stop_rain;
    edge c_ship_green;
    edge c_ship_red;
end
plant automaton Gate1:
  disc int[0..2] h = 0;
  controllable c_gate_rise;
  controllable c_gate_lower;
  uncontrollable u_gate_step;
  location Idle:
    initial;
    marked;
    edge c_gate_rise when h < 2 goto Opening;
    edge c_gate_lower when h > 0 goto Closing;
    edge u_sea_step;
  location Closing:
    marked;
    edge u_gate_step do h := h - 1 goto Moving;
  location Opening:
    marked;
    edge u_gate_step do h := h + 1 goto Moving;
  location Moving:
    marked;
    edge u_sea_step goto Idle;
end
plant automaton Gate2:
  disc int[0..2] h = 0;
  controllable c_gate_rise;
  controllable c_gate_lower;
  uncontrollable u_gate_step;
  location Idle:
    initial;
    marked;
    edge c_gate_rise when h < 2 goto Opening;
    edge c_gate_lower when h > 0 goto Closing;
    edge u_sea_step;
  location Closing:
    marked;
    edge u_gate_step do h := h - 1 goto Moving;
  location Opening:
    marked;
    edge u_gate_step do h := h + 1 goto Moving;
  location Moving:
    marked;
    edge u_sea_step goto Idle;
end
plant automaton Gate3:
  disc int[0..2] h = 0;
  controllable c_gate_rise;
  controllable c_gate_lower;
  uncontrollable u_gate_step;
  location Idle:
    initial;
    marked;
    edge c_gate_rise when h < 2 goto Opening;
    edge c_gate_lower when h > 0 goto Closing;
    edge u_sea_step;
  location Closing:
    marked;
    edge u_gate_step do h := h - 1 goto Moving;
  location Opening:
    marked;
    edge u_gate_step do h := h + 1 goto Moving;
  location Moving:
    marked;
    edge u_sea_step goto Idle;
end
plant automaton Gate4:
  disc int[0..2] h = 0;
  controllable c_gate_rise;
  controllable c_gate_lower;
  uncontrollable u_gate_step;
  location Idle:
    initial;
    marked;
    edge c_gate_rise when h < 2 goto Opening;
    edge c_gate_lower when h > 0 goto Closing;
    edge u_sea_step;
  location Closing:
    marked;
    edge u_gate_step do h := h - 1 goto Moving;
  location Opening:
    marked;
    edge u_gate_step do h := h + 1 goto Moving;
  location Moving:
    marked;
    edge u_sea_step goto Idle;
end
plant automaton sea_level:
  disc int[0..239] k = 0;
  alg int[0..5000] current_water_level = switch k: case 0: 2500 case 1: 2435 case 2: 2369 case 3: 2304 case 4: 2239 case 5: 2174 case 6: 2109 case 7: 2044 case 8: 1980 case 9: 1916 case 10: 1853 case 11: 1790 case 12: 1727 case 13: 1665 case 14: 1604 case 15: 1543 case 16: 1483 case 17: 1424 case 18: 1365 case 19: 1307 case 20: 1250 case 21: 1194 case 22: 1138 case 23: 1084 case 24: 1031 case 25: 978 case 26: 927 case 27: 876 case 28: 827 case 29: 779 case 30: 732 case 31: 687 case 32: 642 case 33: 599 case 34: 557 case 35: 517 case 36: 477 case 37: 440 case 38: 403 case 39: 368 case 40: 335 case 41: 303 case 42: 272 case 43: 244 case 44: 216 case 45: 190 case 46: 166 case 47: 143 case 48: 122 case 49: 103 case 50: 85 case 51: 69 case 52: 55 case 53: 42 case 54: 31 case 55: 21 case 56: 14 case 57: 8 case 58: 3 case 59: 1 case 60: 0 case 61: 1 case 62: 3 case 63: 8 case 64: 14 case 65: 21 case 66: 31 case 67: 42 case 68: 55 case 69: 69 case 70: 85 case 71: 103 case 72: 122 case 73: 143 case 74: 166 case 75: 190 case 76: 216 case 77: 244 case 78: 272 case 79: 303 case 80: 335 case 81: 368 case 82: 403 case 83: 440 case 84: 477 case 85: 517 case 86: 557 case 87: 599 case 88: 642 case 89: 687 case 90: 732 case 91: 779 case 92: 827 case 93: 876 case 94: 927 case 95: 978 case 96: 1031 case 97: 1084 case 98: 1138 case 99: 1194 case 100: 1250 case 101: 1307 case 102: 1365 case 103: 1424 case 104: 1483 case 105: 1543 case 106: 1604 case 107: 1665 case 108: 1727 case 109: 1790 case 110: 1853 case 111: 1916 case 112: 1980 case 113: 2044 case 114: 2109 case 115: 2174 case 116: 2239 case 117: 2304 case 118: 2369 case 119: 2435 case 120: 2500 case 121: 2565 case 122: 2631 case 123: 2696 case 124: 2761 case 125: 2826 case 126: 2891 case 127: 2956 case 128: 3020 case 129: 3084 case 130: 3147 case 131: 3210 case 132: 3273 case 133: 3335 case 134: 3396 case 135: 3457 case 136: 3517 case 137: 3576 case 138: 3635 case 139: 3693 case 140: 3750 case 141: 3806 case 142: 3862 case 143: 3916 case 144: 3969 case 145: 4022 case 146: 4073 case 147: 4124 case 148: 4173 case 149: 4221 case 150: 4268 case 151: 4313 case 152: 4358 case 153: 4401 case 154: 4443 case 155: 4483 case 156: 4523 case 157: 4560 case 158: 4597 case 159: 4632 case 160: 4665 case 161: 4697 case 162: 4728 case 163: 4756 case 164: 4784 case 165: 4810 case 166: 4834 case 167: 4857 case 168: 4878 case 169: 4897 case 170: 4915 case 171: 4931 case 172: 4945 case 173: 4958 case 174: 4969 case 175: 4979 case 176: 4986 case 177: 4992 case 178: 4997 case 179: 4999 case 180: 5000 case 181: 4999 case 182: 4997 case 183: 4992 case 184: 4986 case 185: 4979 case 186: 4969 case 187: 4958 case 188: 4945 case 189: 4931 case 190: 4915 case 191: 4897 case 192: 4878 case 193: 4857 case 194: 4834 case 195: 4810 case 196: 4784 case 197: 4756 case 198: 4728 case 199: 4697 case 200: 4665 case 201: 4632 case 202: 4597 case 203: 4560 case 204: 4523 case 205: 4483 case 206: 4443 case 207: 4401 case 208: 4358 case 209: 4313 case 210: 4268 case 211: 4221 case 212: 4173 case 213: 4124 case 214: 4073 case 215: 4022 case 216: 3969 case 217: 3916 case 218: 3862 case 219: 3806 case 220: 3750 case 221: 3693 case 222: 3635 case 223: 3576 case 224: 3517 case 225: 3457 case 226: 3396 case 227: 3335 case 228: 3273 case 229: 3210 case 230: 3147 case 231: 3084 case 232: 3020 case 233: 2956 case 234: 2891 case 235: 2826 case 236: 2761 case 237: 2696 case 238: 2631 else 2565 end;
  location:
    initial;
    marked;
    edge u_sea_step do k := (k + 1) mod 240;
end
plant automaton ships:
  location red:
    initial;
    edge c_ship_green goto green;
  location green:
    marked;
    edge c_ship_red goto red;
end
plant automaton rain:
  location Dry:
    initial;
    marked;
    edge u_start_rain goto Rain;
  location Rain:
    marked;
    edge u_stop_rain goto Dry;
end
plant automaton fjord_water_level:
  disc int[900..4100] lvl = 2000;
  const int[20..20] gate_coeff = 20;
  alg bool pos_flow = sea_level.current_water_level > lvl;
  alg bool neg_flow = sea_level.current_water_level < lvl;
  alg bool no_flow = sea_level.current_water_level = lvl;
  alg int[0..8] total_open = Gate1.h + Gate2.h + Gate3.h + Gate4.h;
  alg int[0..160] gate_flow = total_open * gate_coeff;
  alg int[0..10] rain_flow = switch rain.Rain: case true: 10 else 0 end;
  location:
    initial;
    marked;
    edge u_sea_step when pos_flow do lvl := lvl + rain_flow + gate_flow;
    edge u_sea_step when neg_flow do lvl := lvl + rain_flow - gate_flow;
    edge u_sea_step when no_flow do lvl := lvl + rain_flow;
end
plant automaton phase:
  location Decide:
    initial;
    marked;
    edge Gate1.c_gate_rise;
    edge Gate1.c_gate_lower;
    edge Gate2.c_gate_rise;
    edge Gate2.c_gate_lower;
    edge Gate3.c_gate_rise;
    edge Gate3.c_gate_lower;
    edge Gate4.c_gate_rise;
    edge Gate4.c_gate_lower;
    edge c_ship_green;
    edge c_ship_red;
    edge Gate1.u_gate_step;
    edge Gate2.u_gate_step;
    edge Gate3.u_gate_step;
    edge Gate4.u_gate_step;
    edge u_start_rain;
    edge u_stop_rain;
    edge c_end_cycle when no_gate_start_pending goto Env;
  location Env:
    marked;
    edge u_start_rain;
    edge u_stop_rain;
    edge u_sea_step goto Decide;
end
supervisor automaton sup:
  alphabet Gate1.c_gate_rise, Gate1.c_gate_lower, Gate2.c_gate_rise, Gate2.c_gate_lower, Gate3.c_gate_rise, Gate3.c_gate_lower, Gate4.c_gate_rise, Gate4.c_gate_lower, c_ship_green, c_ship_red, c_end_cycle;
  location:
    initial;
    marked;
    edge c_end_cycle when bdd_eval(8858, bdd_values);
    edge c_ship_green when bdd_eval(6652, bdd_values);
    edge c_ship_red when true;
    edge Gate1.c_gate_lower when bdd_eval(1052, bdd_values);
    edge Gate1.c_gate_rise when bdd_eval(0, bdd_values);
    edge Gate2.c_gate_lower when bdd_eval(2810, bdd_values);
    edge Gate2.c_gate_rise when bdd_eval(1091, bdd_values);
    edge Gate3.c_gate_lower when bdd_eval(4669, bdd_values);
    edge Gate3.c_gate_rise when bdd_eval(2846, bdd_values);
    edge Gate4.c_gate_lower when bdd_eval(6613, bdd_values);
    edge Gate4.c_gate_rise when bdd_eval(4707, bdd_values);
end
supervisor invariant not(sea_close_zone and Gate1.h > 0);
supervisor invariant not(sea_close_zone and Gate2.h > 0);
supervisor invariant not(sea_close_zone and Gate3.h > 0);
supervisor invariant not(sea_close_zone and Gate4.h > 0);
supervisor invariant Gate1.c_gate_rise needs not(fjord_noncritical and Gate1.h >= 1);
supervisor invariant Gate2.c_gate_rise needs not(fjord_noncritical and Gate2.h >= 1);
supervisor invariant Gate3.c_gate_rise needs not(fjord_noncritical and Gate3.h >= 1);
supervisor invariant Gate4.c_gate_rise needs not(fjord_noncritical and Gate4.h >= 1);
supervisor invariant not(low_conserve_now and fjord_water_level.total_open > 2);
supervisor invariant not(high_protect_now and fjord_water_level.total_open > 1);
supervisor invariant not(low_refill_now and phase.Env and fjord_water_level.total_open < 2);
supervisor invariant not(high_drain_now and phase.Env and fjord_water_level.total_open < 2);
supervisor invariant not(low_refill_now and Gate1.h > 1);
supervisor invariant not(low_refill_now and Gate2.h > 1);
supervisor invariant not(low_refill_now and Gate3.h > 1);
supervisor invariant not(low_refill_now and Gate4.h > 1);
supervisor invariant not(high_drain_now and Gate1.h > 1);
supervisor invariant not(high_drain_now and Gate2.h > 1);
supervisor invariant not(high_drain_now and Gate3.h > 1);
supervisor invariant not(high_drain_now and Gate4.h > 1);
supervisor invariant Gate1.c_gate_rise needs not(low_conserve_now or high_protect_now);
supervisor invariant Gate2.c_gate_rise needs not(low_conserve_now or high_protect_now);
supervisor invariant Gate3.c_gate_rise needs not(low_conserve_now or high_protect_now);
supervisor invariant Gate4.c_gate_rise needs not(low_conserve_now or high_protect_now);
supervisor invariant Gate1.c_gate_lower needs not(low_refill_now or high_drain_now);
supervisor invariant Gate2.c_gate_lower needs not(low_refill_now or high_drain_now);
supervisor invariant Gate3.c_gate_lower needs not(low_refill_now or high_drain_now);
supervisor invariant Gate4.c_gate_lower needs not(low_refill_now or high_drain_now);
supervisor invariant not(fjord_force_high_close and Gate1.h > 0);
supervisor invariant not(fjord_force_high_close and Gate2.h > 0);
supervisor invariant not(fjord_force_high_close and Gate3.h > 0);
supervisor invariant not(fjord_force_high_close and Gate4.h > 0);
supervisor invariant fjord_water_level.lvl <= 4000;
supervisor invariant fjord_water_level.lvl >= 1000;
supervisor invariant c_ship_green needs ship_flow_safe;
supervisor invariant not(ships.green and not ship_flow_safe);
