import "plant.cif";


// -----------------------------------------------------------------------------
// Assumptions for the current plant interface
// - Gate height abstraction: h = 0,1,2 corresponds to 0 m, 3 m, 6 m opening.
// - Ship sign abstraction: ships.red = ships must wait, ships.green = ships may enter.
// - G3 interpretation for this abstraction: one uncontrollable u_gate_step models
//   the required 5 s separation between two gate-actuation starts.
// -----------------------------------------------------------------------------

// Fjord level zones in mm.
alg bool fjord_near_low  = fjord_water_level.lvl <= 1500;
alg bool fjord_near_high = fjord_water_level.lvl >= 3500;
alg bool fjord_noncritical = not (fjord_near_low or fjord_near_high);


// ------------------------------------------------------------------
alg bool sea_rising  = sea_level.k >= 60 and sea_level.k < 180;
alg bool sea_falling = not sea_rising;
alg bool sea_can_refill_fjord = sea_level.current_water_level >= fjord_water_level.lvl;
alg bool sea_can_drain_fjord  = sea_level.current_water_level <= fjord_water_level.lvl;

alg bool low_close_regime  =
    fjord_near_low and (sea_falling or not sea_can_refill_fjord);

alg bool high_close_regime =
    fjord_near_high and (sea_rising or not sea_can_drain_fjord);

alg bool low_open_regime   =
    fjord_near_low and sea_rising and sea_can_refill_fjord;

alg bool high_open_regime  =
    fjord_near_high and sea_falling and sea_can_drain_fjord;

alg bool close_regime = low_close_regime or high_close_regime;
alg bool open_regime  = low_open_regime  or high_open_regime;

requirement invariant not (
    low_close_regime and fjord_water_level.total_open > 2
);

requirement invariant not (
    high_close_regime and fjord_water_level.total_open > 1
);

requirement invariant not (open_regime and Gate1.h > 1);
requirement invariant not (open_regime and Gate2.h > 1);
requirement invariant not (open_regime and Gate3.h > 1);
requirement invariant not (open_regime and Gate4.h > 1);

requirement Gate1.c_gate_rise needs not close_regime;
requirement Gate2.c_gate_rise needs not close_regime;
requirement Gate3.c_gate_rise needs not close_regime;
requirement Gate4.c_gate_rise needs not close_regime;

requirement Gate1.c_gate_lower needs not open_regime;
requirement Gate2.c_gate_lower needs not open_regime;
requirement Gate3.c_gate_lower needs not open_regime;
requirement Gate4.c_gate_lower needs not open_regime;
// alg bool sea_can_refill_fjord =
//     sea_level.current_water_level >= fjord_water_level.lvl;
// alg bool force_close_regime =
//     (fjord_near_low  and (sea_falling or not sea_can_refill_fjord)) or
//     (fjord_near_high and sea_rising);
//
// // Critical low + falling sea: preserve water -> close more.
// requirement invariant not (
//     fjord_near_low and sea_falling and fjord_water_level.total_open > 2
// );
//
// // Critical high + rising sea: protect fjord -> close strongly.
// requirement invariant not (
//     fjord_near_high and sea_rising and fjord_water_level.total_open > 1
// );
//
// // Force close the gates when fjord water lvls are dangerous or can be depending on sea behaviour
// requirement Gate1.c_gate_rise needs not force_close_regime;
// requirement Gate2.c_gate_rise needs not force_close_regime;
// requirement Gate3.c_gate_rise needs not force_close_regime;
// requirement Gate4.c_gate_rise needs not force_close_regime;
// ------------------------------------------------------------------


// Sea thresholds in mm for the current 240-step abstraction.
// G1 itself is "above 4.5 m" -> strictly greater than 4500 mm.
alg bool sea_close_zone = sea_level.current_water_level > 4500;

// Conservative pre-close zone: two sea samples before the first value > 4500.
alg bool sea_preclose_zone = sea_level.current_water_level >= 4443;

// Ship-safety condition from S1.
alg bool ship_flow_safe = abs(fjord_water_level.gate_flow) <= 100;

// -----------------------------------------------------------------------------
// G1: Gates must close when sea water level is above 4.5 m.
// Conservative pre-close restriction added for the coarse abstraction.
// -----------------------------------------------------------------------------

// Redundant due to new time step size for half gate actuation.
// requirement invariant not (sea_preclose_zone and Gate1.h = 2);
// requirement invariant not (sea_preclose_zone and Gate2.h = 2);
// requirement invariant not (sea_preclose_zone and Gate3.h = 2);
// requirement invariant not (sea_preclose_zone and Gate4.h = 2);

requirement invariant not (sea_close_zone and Gate1.h > 0);
requirement invariant not (sea_close_zone and Gate2.h > 0);
requirement invariant not (sea_close_zone and Gate3.h > 0);
requirement invariant not (sea_close_zone and Gate4.h > 0);

requirement req_no_rise_in_preclose:
    location Ok:
        initial;
        marked;

        edge Gate1.c_gate_rise when not sea_preclose_zone;
        edge Gate2.c_gate_rise when not sea_preclose_zone;
        edge Gate3.c_gate_rise when not sea_preclose_zone;
        edge Gate4.c_gate_rise when not sea_preclose_zone;
end

// -----------------------------------------------------------------------------
// G2: At most intermediary height when fjord level is noncritical.
// In the 0/1/2 abstraction, intermediary height is h = 1.
// -----------------------------------------------------------------------------

requirement invariant not (fjord_noncritical and Gate1.h > 1);
requirement invariant not (fjord_noncritical and Gate2.h > 1);
requirement invariant not (fjord_noncritical and Gate3.h > 1);
requirement invariant not (fjord_noncritical and Gate4.h > 1);

// -----------------------------------------------------------------------------
// G3: 5 s interval between gate-actuation starts.
// Modeled here by requiring one uncontrollable u_gate_step between any two
// controllable start events (rise/lower).
// -----------------------------------------------------------------------------

requirement gate_start_interval:
    location Ready:
        initial;
        marked;

        edge Gate1.c_gate_rise  goto Wait;
        edge Gate1.c_gate_lower goto Wait;
        edge Gate2.c_gate_rise  goto Wait;
        edge Gate2.c_gate_lower goto Wait;
        edge Gate3.c_gate_rise  goto Wait;
        edge Gate3.c_gate_lower goto Wait;
        edge Gate4.c_gate_rise  goto Wait;
        edge Gate4.c_gate_lower goto Wait;

        edge u_sea_step;
        edge u_start_rain;
        edge u_stop_rain;
        edge c_ship_green;
        edge c_ship_red;

    location Wait:
        marked;

        edge Gate1.u_gate_step goto Ready;
        edge Gate2.u_gate_step goto Ready;
        edge Gate3.u_gate_step goto Ready;
        edge Gate4.u_gate_step goto Ready;

        edge u_start_rain;
        edge u_stop_rain;
        edge c_ship_green;
        edge c_ship_red;
end

// -----------------------------------------------------------------------------
// L1/L2: Fjord level bounds.
// -----------------------------------------------------------------------------

requirement invariant fjord_water_level.lvl <= 4000;
requirement invariant fjord_water_level.lvl >= 1000;

// -----------------------------------------------------------------------------
// S1: Ships may only be allowed when the generated flow is small enough.
// With the current plant, this is modeled by constraining the sign.
// -----------------------------------------------------------------------------

requirement c_ship_green needs ship_flow_safe;
requirement invariant not (ships.green and not ship_flow_safe);
// -----------------------------------------------------------------------------
// S2 is still not formalized here.
// Reason: with only a red/green sign state and no ship request / waiting notion,
// "allowed once in a while" is not a well-posed supervisory requirement.
// It can be discussed in the report as a plant-model assumption/limitation.
// -----------------------------------------------------------------------------



