import "plant.cif";

// Fjord level zones in mm.
alg bool fjord_near_low  = fjord_water_level.lvl <= 1500;
alg bool fjord_near_high = fjord_water_level.lvl >= 3500;
alg bool fjord_noncritical = not (fjord_near_low or fjord_near_high);

// Two-threshold G1 for the coarser 36-step sea model.
alg bool sea_preclose_zone = sea_level.current_water_level >= 4107;
alg bool sea_close_zone    = sea_level.current_water_level >= 4415;


// G1a: once sea enters the pre-close zone, gates may not be at 6 m.
requirement invariant not (sea_preclose_zone and Gate1.h = 6);
requirement invariant not (sea_preclose_zone and Gate2.h = 6);
requirement invariant not (sea_preclose_zone and Gate3.h = 6);
requirement invariant not (sea_preclose_zone and Gate4.h = 6);

// G1b: once sea enters the pre-close zone, no new rise commands are allowed.
requirement req_no_rise_in_preclose:
    location Ok:
        initial;
        marked;

        edge c_g1_rise when not sea_preclose_zone;
        edge c_g2_rise when not sea_preclose_zone;
        edge c_g3_rise when not sea_preclose_zone;
        edge c_g4_rise when not sea_preclose_zone;
end

// G1c: once sea enters the actual close zone, all gates must be closed.
requirement invariant not (sea_close_zone and Gate1.h > 0);
requirement invariant not (sea_close_zone and Gate2.h > 0);
requirement invariant not (sea_close_zone and Gate3.h > 0);
requirement invariant not (sea_close_zone and Gate4.h > 0);

// G2: when fjord is noncritical, a gate may not be at 6 m.
requirement invariant not (fjord_noncritical and Gate1.h = 6);
requirement invariant not (fjord_noncritical and Gate2.h = 6);
requirement invariant not (fjord_noncritical and Gate3.h = 6);
requirement invariant not (fjord_noncritical and Gate4.h = 6);

// L1/L2: fjord level must stay in range.
requirement invariant fjord_water_level.lvl <= 4000;
requirement invariant fjord_water_level.lvl >= 1000;
